{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noImplicitAny": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "sourceMap": true,
    "declaration": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "drizzle.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}